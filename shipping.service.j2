[Unit]
Description=Shipping Service
After=network-online.target

[Service]
User=roboshop
Environment=CART_ENDPOINT={{ CART_HOST }}:8080
Environment=DB_HOST={{ MYSQL_HOST }}
Environment=DB_USER=shipping
Environment=DB_PASSWORD=RoboShop@1
ExecStart=/bin/java  -Djdk.tls.namedGroups=secp256r1,secp384r1  -jar /app/shipping.jar
SyslogIdentifier=shipping
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
